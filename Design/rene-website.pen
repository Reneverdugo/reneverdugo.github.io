                  "fill": "$text-primary",
                  "content": "René Verdugo",
                  "fontFamily": "$font-main",
                  "fontSize": 14,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "Hp99g",
                  "x": 260,
                  "y": 352,
                  "name": "Article Date",
                  "fill": "$text-muted",
                  "content": "Jun 3, 2026",
                  "fontFamily": "$font-main",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "rectangle",
                  "id": "UJ6BJ",
                  "x": 248,
                  "y": 355,
                  "name": "Date Sep",
                  "fill": "$text-muted",
                  "width": 1,
                  "height": 14
                },
                {
                  "type": "rectangle",
                  "cornerRadius": 16,
                  "id": "jOZD7",
                  "x": 120,
                  "y": 400,
                  "name": "Hero Img",
                  "fill": {
                    "type": "gradient",
                    "gradientType": "linear",
                    "enabled": true,
                    "rotation": 135,
                    "size": {
                      "height": 1
                    },
                    "colors": [
                      {
                        "color": "#0d1f3c",
                        "position": 0
                      },
                      {
                        "color": "#162d5a",
                        "position": 0.5
                      },
                      {
                        "color": "#1a3d6e",
                        "position": 1
                      }
                    ]
                  },
                  "width": 1200,
                  "height": 420
                },
                {
                  "type": "text",
                  "id": "i25DY",
                  "x": 120,
                  "y": 400,
                  "name": "Hero Label",
                  "fill": "$text-muted",
                  "textGrowth": "fixed-width-height",
                  "width": 1200,
                  "height": 420,
                  "content": "Cover image",
                  "textAlign": "center",
                  "textAlignVertical": "middle",
                  "fontFamily": "$font-main",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "tpiDN",
                  "x": 120,
                  "y": 876,
                  "name": "Lead Para",
                  "fill": "$text-primary",
                  "textGrowth": "fixed-width",
                  "width": 720,
                  "content": "A well-built design system is the invisible backbone of every great product. It's the difference between a team that moves fast and ships confidently, and one that debates button radii in every sprint.",
                  "lineHeight": 1.7,
                  "fontFamily": "$font-main",
                  "fontSize": 19,
                  "fontWeight": "500"
                },
                {
                  "type": "rectangle",
                  "id": "GU1mT",
                  "x": 120,
                  "y": 960,
                  "name": "Div Art",
                  "fill": "$border",
                  "width": 720,
                  "height": 1
                },
                {
                  "type": "text",
                  "id": "ItKm2",
                  "x": 120,
                  "y": 980,
                  "name": "Para 1",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": 720,
                  "content": "Most teams I've worked with discover the value of a design system the hard way — after shipping three slightly different versions of the same button, or when a brand refresh requires updating 200 screens individually.",
                  "lineHeight": 1.8,
                  "fontFamily": "$font-main",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "rectangle",
                  "cornerRadius": 2,
                  "id": "rG813",
                  "x": 120,
                  "y": 1096,
                  "name": "Quote Bar",
                  "fill": "$accent",
                  "width": 4,
                  "height": 96
                },
                {
                  "type": "text",
                  "id": "jtRaj",
                  "x": 140,
                  "y": 1096,
                  "name": "Pull Quote",
                  "fill": "$text-primary",
                  "textGrowth": "fixed-width",
                  "width": 680,
                  "content": "\"Consistency is not about being boring. It's about freeing your team to focus on the problems that actually matter.\"",
                  "lineHeight": 1.55,
                  "fontFamily": "$font-main",
                  "fontSize": 20,
                  "fontWeight": "600",
                  "fontStyle": "italic"
                },
                {
                  "type": "text",
                  "id": "bo73j",
                  "x": 120,
                  "y": 1232,
                  "name": "Para 2 H",
                  "fill": "$text-primary",
                  "content": "The anatomy of a good system",
                  "fontFamily": "$font-main",
                  "fontSize": 24,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "tu9Fw",
                  "x": 120,
                  "y": 1268,
                  "name": "Para 2 Body",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": 720,
                  "content": "A design system isn't just a Figma file with components. It's a shared language — an agreement between design and engineering about how the product looks, feels, and behaves. The best systems I've seen have three things in common: they're documented, they're maintained, and they're genuinely used.",
                  "lineHeight": 1.8,
                  "fontFamily": "$font-main",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "p3kD9P",
                  "x": 120,
                  "y": 1440,
                  "name": "List Num 1",
                  "fill": "$accent",
                  "content": "1",
                  "fontFamily": "$font-main",
                  "fontSize": 28,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "U8P9kQ",
                  "x": 160,
                  "y": 1444,
                  "name": "List Title 1",
                  "fill": "$text-primary",
                  "content": "Tokens before components",
                  "fontFamily": "$font-main",
                  "fontSize": 17,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "DKOWj",
                  "x": 160,
                  "y": 1470,
                  "name": "List Body 1",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": 660,
                  "content": "Start with color, spacing, and type scales as design tokens. Everything else builds on these foundations.",
                  "lineHeight": 1.7,
                  "fontFamily": "$font-main",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "euAu9",
                  "x": 120,
                  "y": 1570,
                  "name": "List Num 2",
                  "fill": "$accent",
                  "content": "2",
                  "fontFamily": "$font-main",
                  "fontSize": 28,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "x9hRe7",
                  "x": 160,
                  "y": 1574,
                  "name": "List Title 2",
                  "fill": "$text-primary",
                  "content": "Document in context",
                  "fontFamily": "$font-main",
                  "fontSize": 17,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "I27WL",
                  "x": 160,
                  "y": 1600,
                  "name": "List Body 2",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": 660,
                  "content": "Don't write docs separately — embed them in the system itself. Storybook and Figma annotations both work.",
                  "lineHeight": 1.7,
                  "fontFamily": "$font-main",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "k8fwLc",
                  "x": 120,
                  "y": 1700,
                  "name": "List Num 3",
                  "fill": "$accent",
                  "content": "3",
                  "fontFamily": "$font-main",
                  "fontSize": 28,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "X2MnOs",
                  "x": 160,
                  "y": 1704,
                  "name": "List Title 3",
                  "fill": "$text-primary",
                  "content": "Treat it as a product",
                  "fontFamily": "$font-main",
                  "fontSize": 17,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "AWwMs",
                  "x": 160,
                  "y": 1730,
                  "name": "List Body 3",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": 660,
                  "content": "The system needs an owner, a roadmap, and versioning. Abandon that and it becomes a graveyard.",
                  "lineHeight": 1.7,
                  "fontFamily": "$font-main",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "M7Pur",
                  "x": 120,
                  "y": 1860,
                  "name": "Para 3 H",
                  "fill": "$text-primary",
                  "content": "Getting buy-in from engineering",
                  "fontFamily": "$font-main",
                  "fontSize": 24,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "o2bXn1",
                  "x": 120,
                  "y": 1900,
                  "name": "Para 3 Body",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": 720,
                  "content": "The hardest part isn't building the system — it's getting the team to actually use it. I've found the fastest path is to solve a real, painful problem that already exists. Fix the inconsistent spacing issue that's been annoying the front-end team for months. Ship that. Then build from there.",
                  "lineHeight": 1.8,
                  "fontFamily": "$font-main",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "rectangle",
                  "cornerRadius": 12,
                  "id": "dcNwe",
                  "x": 1040,
                  "y": 876,
                  "name": "Sidebar Bg",
                  "fill": "$bg-elevated",
                  "width": 280,
                  "height": 380,
                  "stroke": {
                    "align": "inside",
                    "thickness": 1,
                    "fill": "$border"
                  }
                },
                {
                  "type": "text",
                  "id": "vcd7K",
                  "x": 1068,
                  "y": 908,
                  "name": "Sidebar H",
                  "fill": "$text-primary",
                  "content": "In this article",
                  "fontFamily": "$font-main",
                  "fontSize": 14,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "iOw4p",
                  "x": 1068,
                  "y": 940,
                  "name": "TOC 1",
                  "fill": "$text-secondary",
                  "content": "What makes a system good",
                  "fontFamily": "$font-main",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "R5TPRZ",
                  "x": 1068,
                  "y": 976,
                  "name": "TOC 2",
                  "fill": "$text-secondary",
                  "content": "Anatomy of a good system",
                  "fontFamily": "$font-main",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "D2iLr4",
                  "x": 1068,
                  "y": 1012,
                  "name": "TOC 3",
                  "fill": "$text-secondary",
                  "content": "Tokens before components",
                  "fontFamily": "$font-main",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
