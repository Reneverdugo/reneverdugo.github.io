---
import { ui } from "../i18n/ui";

const path = Astro.url.pathname;
const lang = path.startsWith("/es") ? "es" : "en";
const base = lang === "es" ? "/es" : "";
const t = ui[lang].nav;

const links = [
  { href: `${base}/`, label: t.home },
  { href: `${base}/portfolio`, label: t.portfolio },
  { href: `${base}/blog`, label: t.blog },
  { href: `${base}/cv`, label: t.cv },
  { href: `${base}/contact`, label: t.contact },
];

// Language switcher URLs
const pathWithoutBase = lang === "es" ? path.replace(/^\/es/, "") || "/" : path;
const enUrl = pathWithoutBase;
const esUrl = pathWithoutBase === "/" ? "/es" : `/es${pathWithoutBase}`;

function isActive(href: string): boolean {
  const home = `${base}/`;
  if (href === home || href === base) return path === href || path === base || path === base + "/";
  return path === href || path.startsWith(href + "/");
}
---

<header
  class="fixed top-0 left-0 right-0 z-50 border-b"
  style="background-color: var(--bg-3); border-color: var(--bd);"
>
  <div class="max-w-[1200px] mx-auto px-6 xl:px-0 h-[72px] flex items-center justify-between">
    <a href={`${base}/`} class="text-[28px] font-bold" style="color: var(--fg);">R.</a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-8">
      {
        links.map(({ href, label }) => (
          <a
            href={href}
            class="text-[14px] font-medium transition-colors hover:text-accent"
            style={isActive(href) ? "color: var(--accent);" : "color: var(--fg-2);"}
          >
            {label}
          </a>
        ))
      }

      <!-- Language switcher -->
      <div class="flex items-center gap-1 text-[13px] font-semibold">
        <a
          href={enUrl}
          onclick="localStorage.setItem('preferred-lang','en')"
          class="px-2 py-0.5 rounded transition-colors"
          style={lang === "en" ? "color: var(--accent);" : "color: var(--fg-3);"}
        >EN</a>
        <span style="color: var(--bd);">|</span>
        <a
          href={esUrl}
          onclick="localStorage.setItem('preferred-lang','es')"
          class="px-2 py-0.5 rounded transition-colors"
          style={lang === "es" ? "color: var(--accent);" : "color: var(--fg-3);"}
        >ES</a>
      </div>

      <button
        id="theme-toggle"
        class="w-8 h-8 flex items-center justify-center rounded-full transition-colors"
        style="background-color: var(--bg-2);"
        aria-label="Toggle theme"
      >
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--fg-2);">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--fg-2); display: none;">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
    </nav>

    <!-- Mobile: theme toggle + hamburger -->
    <div class="flex md:hidden items-center gap-3">
      <!-- Language switcher mobile -->
      <div class="flex items-center gap-1 text-[12px] font-semibold">
        <a
          href={enUrl}
          onclick="localStorage.setItem('preferred-lang','en')"
          style={lang === "en" ? "color: var(--accent);" : "color: var(--fg-3);"}
        >EN</a>
        <span style="color: var(--bd);">|</span>
        <a
          href={esUrl}
          onclick="localStorage.setItem('preferred-lang','es')"
          style={lang === "es" ? "color: var(--accent);" : "color: var(--fg-3);"}
        >ES</a>
      </div>

      <button
        id="theme-toggle-mobile"
        class="w-8 h-8 flex items-center justify-center rounded-full"
        style="background-color: var(--bg-2);"
        aria-label="Toggle theme"
      >
        <svg id="icon-sun-mobile" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--fg-2);">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg id="icon-moon-mobile" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--fg-2); display: none;">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <button
        id="menu-toggle"
        class="w-8 h-8 flex flex-col items-center justify-center gap-[5px]"
        aria-label="Open menu"
      >
        <span class="block w-5 h-[1.5px]" style="background-color: var(--fg);"></span>
        <span class="block w-5 h-[1.5px]" style="background-color: var(--fg);"></span>
        <span class="block w-3 h-[1.5px]" style="background-color: var(--fg);"></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu drawer -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t"
    style="background-color: var(--bg-3); border-color: var(--bd);"
  >
    <nav class="flex flex-col px-6 py-4 gap-4">
      {
        links.map(({ href, label }) => (
          <a
            href={href}
            class="text-[15px] font-medium py-1"
            style={isActive(href) ? "color: var(--accent);" : "color: var(--fg-2);"}
          >
            {label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  function initNav() {
    const html = document.documentElement;

    function syncIcons() {
      const isLight = html.getAttribute("data-theme") === "light";
      const show = (id: string, visible: boolean) => {
        const el = document.getElementById(id) as HTMLElement | null;
        if (el) el.style.display = visible ? "block" : "none";
      };
      show("icon-sun", !isLight);
      show("icon-moon", isLight);
      show("icon-sun-mobile", !isLight);
      show("icon-moon-mobile", isLight);
    }

    function toggleTheme() {
      const isLight = html.getAttribute("data-theme") === "light";
      if (isLight) {
        html.removeAttribute("data-theme");
        localStorage.setItem("theme", "dark");
      } else {
        html.setAttribute("data-theme", "light");
        localStorage.setItem("theme", "light");
      }
      syncIcons();
    }

    syncIcons();
    document.getElementById("theme-toggle")?.addEventListener("click", toggleTheme);
    document.getElementById("theme-toggle-mobile")?.addEventListener("click", toggleTheme);

    const menuBtn = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    menuBtn?.addEventListener("click", () => {
      mobileMenu?.classList.toggle("hidden");
    });
  }

  initNav();
  document.addEventListener("astro:page-load", initNav);
</script>
