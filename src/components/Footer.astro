---
import { ui } from "../i18n/ui";

const path = Astro.url.pathname;
const lang = path.startsWith("/es") ? "es" : "en";
const base = lang === "es" ? "/es" : "";
const t = ui[lang].footer;
const year = new Date().getFullYear();
---

<footer class="border-t" style="border-color: var(--bd);">
  <div class="max-w-[1200px] mx-auto px-6 xl:px-0 py-12">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <!-- Left: logo + tagline -->
      <div>
        <a href={`${base}/`} class="text-[24px] font-bold block mb-1" style="color: var(--fg);">R.</a>
        <p class="text-[13px]" style="color: var(--fg-3);">{t.tagline}</p>
      </div>

      <!-- Center: nav links -->
      <nav class="flex flex-wrap gap-x-8 gap-y-2">
        {
          [
            { href: `${base}/`, label: ui[lang].nav.home },
            { href: `${base}/portfolio`, label: ui[lang].nav.portfolio },
            { href: `${base}/blog`, label: ui[lang].nav.blog },
            { href: `${base}/contact`, label: ui[lang].nav.contact },
          ].map(({ href, label }) => (
            <a
              href={href}
              class="text-[13px] transition-colors hover:text-accent"
              style="color: var(--fg-2);"
            >
              {label}
            </a>
          ))
        }
      </nav>

      <!-- Right: social links -->
      <div class="flex items-center gap-4">
        <a
          href="https://github.com/reneverdugo"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[13px] transition-colors hover:text-accent"
          style="color: var(--fg-3);"
          aria-label="GitHub"
        >
          GitHub
        </a>
        <a
          href="https://linkedin.com/in/rene-verdugo-design/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[13px] transition-colors hover:text-accent"
          style="color: var(--fg-3);"
          aria-label="LinkedIn"
        >
          LinkedIn
        </a>
      </div>
    </div>

    <div class="mt-8 pt-6 border-t flex flex-col md:flex-row items-center gap-2" style="border-color: var(--bd);">
      <p class="text-[12px]" style="color: var(--fg-3);">© {year} René Verdugo. {t.rights}</p>
    </div>
  </div>
</footer>
