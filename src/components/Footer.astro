---
const year = new Date().getFullYear();
---

<footer class="border-t" style="border-color: var(--bd);">
  <div class="max-w-[1200px] mx-auto px-6 xl:px-0 py-12">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <!-- Left: logo + tagline -->
      <div>
        <a href="/" class="text-[24px] font-bold block mb-1" style="color: var(--fg);">R.</a>
        <p class="text-[13px]" style="color: var(--fg-3);">Designing with purpose, one pixel at a time.</p>
      </div>

      <!-- Center: nav links -->
      <nav class="flex flex-wrap gap-x-8 gap-y-2">
        {
          [
            { href: "/", label: "Home" },
            { href: "/portfolio", label: "Portfolio" },
            { href: "/blog", label: "Blog" },
            { href: "/contact", label: "Contact" },
          ].map(({ href, label }) => (
            <a
              href={href}
              class="text-[13px] transition-colors hover:text-accent"
              style="color: var(--fg-2);"
            >
              {label}
            </a>
          ))
        }
      </nav>

      <!-- Right: social links -->
      <div class="flex items-center gap-4">
        <a
          href="https://github.com/reneverdugo"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[13px] transition-colors hover:text-accent"
          style="color: var(--fg-3);"
          aria-label="GitHub"
        >
          GitHub
        </a>
        <a
          href="https://linkedin.com/in/rene-verdugo-design/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[13px] transition-colors hover:text-accent"
          style="color: var(--fg-3);"
          aria-label="LinkedIn"
        >
          LinkedIn
        </a>
      </div>
    </div>

    <div class="mt-8 pt-6 border-t flex flex-col md:flex-row items-center justify-between gap-2" style="border-color: var(--bd);">
      <p class="text-[12px]" style="color: var(--fg-3);">© {year} René Verdugo. All rights reserved.</p>
      <p class="text-[12px]" style="color: var(--fg-3);">Designed & built by me.</p>
    </div>
  </div>
</footer>
