---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: "en" | "es";
}

const {
  title,
  description = "René Verdugo — UX/UI Designer crafting digital products that blend clarity with delight.",
  image = "/images/og-default.png",
  lang = "en",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://reneverdugo.xyz");
const ogImage = new URL(image, "https://reneverdugo.xyz");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} — René Verdugo`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — René Verdugo`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&display=swap"
      rel="stylesheet"
    />
    <title>{title} — René Verdugo</title>

    <!-- Prevent flash of wrong theme: runs synchronously before first paint -->
    <script is:inline>
      (function () {
        var saved = localStorage.getItem("theme");
        if (saved === "light") {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>

    <!-- Auto language detection (first visit only) -->
    <script is:inline>
      (function () {
        var saved = localStorage.getItem("preferred-lang");
        if (saved) return;
        var browserLang = (navigator.language || "").toLowerCase();
        var isSpanish = browserLang.startsWith("es");
        var isOnEsPage = window.location.pathname.startsWith("/es");
        localStorage.setItem("preferred-lang", isSpanish ? "es" : "en");
        if (isSpanish && !isOnEsPage) {
          var p = window.location.pathname;
          window.location.replace("/es" + (p === "/" ? "" : p) + window.location.search);
        }
      })();
    </script>

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-24VL8KWRE4" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-24VL8KWRE4');
    </script>

    <!-- Microsoft Clarity -->
    <script type="text/javascript" is:inline>
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "xkhu1kmz6s");
    </script>
  </head>
  <body style="background-color: var(--bg); color: var(--fg); font-family: 'DM Sans', sans-serif;">
    <Nav />
    <main class="pt-[72px]">
      <slot />
    </main>
    <Footer />
  </body>
</html>
