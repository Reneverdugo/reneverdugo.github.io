---
import Layout from "../layouts/Layout.astro";

const experience = [
  {
    title: "Lead UX/UI Designer",
    company: "Freelance & Clients",
    period: "2022 — Present",
    bullets: [
      "Led end-to-end design for 8+ projects spanning fintech, travel, and SaaS verticals.",
      "Grew client base to 12 repeat clients through referrals and portfolio work.",
      "Established design system standards adopted by 3 engineering teams.",
    ],
  },
  {
    title: "Web Developer / UX/UI Designer",
    company: "BitsKingdom",
    period: "2020 — 2025",
    bullets: [
      "Led end-to-end web design projects for multiple clients, including marketing websites, landing pages, and web applications.",
      "Created wireframes, user flows, and high-fidelity UI designs aligned with business goals and user needs.",
      "Translated abstract and ambiguous requirements into structured UX and polished UI solutions.",
      "Built and maintained design systems, UI components, and reusable patterns in Figma.",
      "Collaborated with developers to ensure technical feasibility, efficient implementation, and design accuracy.",
      "Delivered responsive design solutions optimized for multiple devices and screen sizes.",
      "Presented design concepts, rationale, and iterations to clients and stakeholders.",
      "Managed multiple projects simultaneously in a fast-paced remote environment.",
    ],
  },
  {
    title: "UX/UI Designer",
    company: "Crol",
    period: "2019 — 2020",
    bullets: [
      "Designed responsive web interfaces focused on usability, clarity, and performance.",
      "Improved user experience for platforms in travel and automotive industries.",
      "Created wireframes and UI designs based on user needs and business requirements.",
      "Collaborated with cross-functional teams to iterate on product features and flows.",
    ],
  },
  {
    title: "UI Designer",
    company: "Emcor Software",
    period: "2016 — 2019",
    bullets: [
      "Designed user interfaces for web and mobile applications.",
      "Developed visual systems, UI components, and icon sets for digital products.",
      "Contributed to product design from concept to delivery.",
      "Collaborated with internal teams to improve usability and design consistency.",
    ],
  },
];

const skills = {
  Design: ["UX Research", "Interaction Design", "Visual Design", "Prototyping", "Design Systems"],
  Tools: ["Figma", "FigJam", "Notion", "Photoshop", "Ilustrator", "Spline", "Webflow", "Git"],
  "Dev Collab": ["HTML/CSS", "JavaScript", "WordPress", "Handoff specs", "Spec Driven Development"],
};

const certifications = [
  { name: "User Experience: The Beginner’s Guide - IxDF", year: "2024" },
  { name: "Mastering Digital Product Design - Udemy", year: "2020" },
];

const awards = [
  {
    name: "Awwwards Honorable Mention",
    project: "BitForex Website Redesign",
    year: "2024",
  },
  {
    name: "Behance Featured Project",
    project: "Kohi App — iOS & Android",
    year: "2022",
  },
  {
    name: "CSS Design Awards",
    project: "Studio Interior Amsterdam",
    year: "2020",
  },
];
---

<Layout
  title="CV"
  description="René Verdugo — UX/UI Designer with 8+ years crafting digital products for startups and scale-ups."
>
  <!-- Header band -->
  <div class="py-14" style="background-color: var(--bg-2);">
    <div class="max-w-[1200px] mx-auto px-6 xl:px-0">
      <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-10">
        <!-- Left: name + role + summary -->
        <div class="max-w-[600px]">
          <h1 class="text-[52px] md:text-[60px] font-bold leading-none mb-4" style="color: var(--fg);">
            René Verdugo
          </h1>
          <p class="text-[26px] font-light mb-6" style="color: var(--accent);">UX/UI Designer</p>
          <p class="text-[16px] leading-[1.7]" style="color: var(--fg-2);">
            UX/UI Designer with 9+ years of experience in web design, digital product design, and responsive interfaces. Proven track
            record leading end-to-end design projects, from research and wireframes to high-fidelity UI and developer handoff.
            Experienced in translating complex and ambiguous requirements into clear, scalable design solutions. Strong expertise in
            design systems, UI components, and cross-functional collaboration with developers and stakeholders.
            Skilled in delivering high-quality design under tight deadlines, maintaining usability, accessibility, and visual consistency across
            platforms
          </p>
        </div>

        <!-- Right: contact + buttons -->
        <div class="flex flex-col gap-5">
          <div class="flex flex-col gap-2">
            <a
              href="mailto:hola@reneverdugo.xyz"
              class="text-[13px] transition-opacity hover:opacity-70"
              style="color: var(--fg-2);"
            >
              ✉  hola@reneverdugo.xyz
            </a>
            <span class="text-[13px]" style="color: var(--fg-2);">🌐  reneverdugo.xyz</span>
            <span class="text-[13px]" style="color: var(--fg-2);">📍  Remote · MX</span>
          </div>
          <div class="flex gap-3">
            <a
              href="#"
              class="inline-flex items-center justify-center rounded-lg text-[14px] font-semibold px-6 h-12 transition-opacity hover:opacity-85"
              style="background-color: var(--accent); color: #fff;"
            >
              ↓  Download PDF
            </a>
            <button
              class="inline-flex items-center justify-center rounded-lg text-[14px] border px-5 h-12 transition-opacity hover:opacity-75"
              style="border-color: var(--bd); background-color: var(--bg-3); color: var(--fg-2);"
              onclick="navigator.clipboard.writeText(window.location.href)"
            >
              Share link →
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main content -->
  <div class="border-t" style="border-color: var(--bd);">
    <div class="max-w-[1200px] mx-auto px-6 xl:px-0 py-12">
      <div class="flex flex-col lg:flex-row gap-16">

        <!-- Experience column -->
        <div class="flex-1 min-w-0">
          <p
            class="text-[11px] font-bold tracking-[2px] uppercase mb-8"
            style="color: var(--accent);"
          >
            EXPERIENCE
          </p>

          <div class="flex flex-col gap-12">
            {
              experience.map((job) => (
                <div class="flex gap-5">
                  <div
                    class="w-[3px] shrink-0 rounded-full mt-1"
                    style="background-color: var(--accent); height: 100px;"
                  />
                  <div>
                    <h3 class="text-[20px] font-bold mb-1" style="color: var(--fg);">
                      {job.title}
                    </h3>
                    <p class="text-[15px] mb-1" style="color: var(--accent);">
                      {job.company}
                    </p>
                    <p class="text-[13px] mb-4" style="color: var(--fg-3);">
                      {job.period}
                    </p>
                    <ul class="flex flex-col gap-2">
                      {job.bullets.map((b) => (
                        <li class="text-[14px] leading-[1.75]" style="color: var(--fg-2);">
                          · {b}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Sidebar: Skills + Education + Certs -->
        <aside class="w-full lg:w-[380px] shrink-0">

          <!-- Skills -->
          <p
            class="text-[11px] font-bold tracking-[2px] uppercase mb-6"
            style="color: var(--accent);"
          >
            SKILLS
          </p>

          <div class="flex flex-col gap-6 mb-10">
            {
              Object.entries(skills).map(([category, tags]) => (
                <div>
                  <p class="text-[14px] font-bold mb-3" style="color: var(--fg);">
                    {category}
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {tags.map((tag) => (
                      <span
                        class="inline-flex items-center rounded-full px-3 h-[30px] text-[12px] border"
                        style="background-color: var(--bg-3); border-color: var(--bd); color: var(--fg-2);"
                      >
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>

          <div class="border-t mb-8" style="border-color: var(--bd);"></div>

          <!-- Education -->
          <p
            class="text-[11px] font-bold tracking-[2px] uppercase mb-5"
            style="color: var(--accent);"
          >
            EDUCATION
          </p>
          <p class="text-[16px] font-bold mb-1" style="color: var(--fg);">
            Licenciatura en Diseño Gráfico (Equivalent to a Bachelor's Degree in Graphic Design)
          </p>
          <p class="text-[14px] mb-1" style="color: var(--fg-2);">ITSON, Ciudad Obregón, Sonora, México</p>
          <p class="text-[13px] mb-8" style="color: var(--fg-3);">2008 — 2012</p>

          <div class="border-t mb-8" style="border-color: var(--bd);"></div>

          <!-- Certifications -->
          <p
            class="text-[11px] font-bold tracking-[2px] uppercase mb-5"
            style="color: var(--accent);"
          >
            CERTIFICATIONS
          </p>
          <div class="flex flex-col gap-3">
            {
              certifications.map((cert) => (
                <div class="flex justify-between items-baseline">
                  <p class="text-[13px]" style="color: var(--fg-2);">{cert.name}</p>
                  <p class="text-[12px] shrink-0 ml-4" style="color: var(--fg-3);">{cert.year}</p>
                </div>
              ))
            }
          </div>
        </aside>
      </div>
    </div>
  </div>

  <!-- Recognition -->
  <!--<div class="border-t" style="border-color: var(--bd);">
    <div class="max-w-[1200px] mx-auto px-6 xl:px-0 py-12">
      <p
        class="text-[11px] font-bold tracking-[2px] uppercase mb-8"
        style="color: var(--accent);"
      >
        RECOGNITION
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {
          awards.map((award) => (
            <div>
              <p class="text-[16px] font-semibold mb-1" style="color: var(--fg);">
                {award.name}
              </p>
              <p class="text-[13px] mb-1" style="color: var(--fg-2);">{award.project}</p>
              <p class="text-[12px]" style="color: var(--fg-3);">{award.year}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>-->

  <!-- CTA band -->
  <div class="py-20" style="background-color: var(--bg-2);">
    <div class="max-w-[1200px] mx-auto px-6 xl:px-0 flex flex-col md:flex-row md:items-center md:justify-between gap-8">
      <div>
        <h2 class="text-[36px] font-bold mb-3" style="color: var(--fg);">
          Open to new opportunities.
        </h2>
        <p class="text-[16px]" style="color: var(--fg-2);">
          Currently available for freelance and contract design work.
        </p>
      </div>
      <a
        href="/contact"
        class="inline-flex items-center justify-center rounded-lg text-[15px] font-semibold px-8 h-12 shrink-0 transition-opacity hover:opacity-85"
        style="background-color: var(--accent); color: #fff;"
      >
        Get in touch
      </a>
    </div>
  </div>
</Layout>
