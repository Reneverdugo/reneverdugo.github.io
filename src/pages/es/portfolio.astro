---
import { existsSync } from "fs";
import { join } from "path";
import Layout from "../../layouts/Layout.astro";
import { getProjects } from "../../lib/notion";
import { ui } from "../../i18n/ui";

const t = ui.es;
const projects = await getProjects();

function thumbImg(slug: string): string | null {
  const rel = `/images/projects/${slug}/thumbnail.png`;
  return existsSync(join(process.cwd(), "public", rel)) ? rel : null;
}
---

<Layout
  title="Portafolio"
  description="Portafolio de René Verdugo — proyectos de diseño UX/UI en web, mobile y producto."
  lang="es"
>
  <div class="max-w-[1200px] mx-auto px-6 xl:px-0 py-16 md:py-24">
    <div class="mb-16">
      <p class="text-[11px] font-bold tracking-[2px] uppercase mb-4" style="color: var(--accent);">
        {t.portfolio.eyebrow}
      </p>
      <h1 class="text-[48px] md:text-[60px] font-bold leading-[1.05] mb-6" style="color: var(--fg);">
        {t.portfolio.h1}
      </h1>
      <p class="text-[17px] leading-[1.65] max-w-[540px]" style="color: var(--fg-2);">
        {t.portfolio.desc}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        projects.map((project) => (
          <a
            href={`/es/portfolio/${project.slug}`}
            class="group block rounded-xl border overflow-hidden transition-all duration-200 hover:-translate-y-1"
            style="background-color: var(--bg-3); border-color: var(--bd);"
          >
            {thumbImg(project.slug) ? (
              <img src={thumbImg(project.slug)!} alt={project.title} class="h-[240px] md:h-[320px] w-full object-cover" />
            ) : (
              <div class="h-[240px] md:h-[320px] w-full" style={`background-color: ${project.color};`} />
            )}
            <div class="p-6 md:p-7">
              <p class="text-[11px] font-bold tracking-[1.5px] uppercase mb-2" style="color: var(--accent);">{project.type}</p>
              <h2 class="text-[20px] md:text-[22px] font-semibold mb-2" style="color: var(--fg);">{project.title}</h2>
              <p class="text-[14px] leading-[1.55]" style="color: var(--fg-2);">{project.description}</p>
              <p class="mt-5 text-[20px] transition-transform duration-200 group-hover:translate-x-1" style="color: var(--accent);">→</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
