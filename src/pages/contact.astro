---
import Layout from "../layouts/Layout.astro";

const socials = [
  { name: "Twitter / X", handle: "@reneverdugo", href: "https://twitter.com/reneverdugo" },
  { name: "LinkedIn", handle: "in/rene-verdugo-design", href: "https://linkedin.com/in/rene-verdugo-desing/" },
  { name: "GitHub", handle: "@reneverdugo", href: "https://github.com/reneverdugo" },
  { name: "Dribbble", handle: "reneverdugo", href: "https://dribbble.com/reneverdugo" },
];
---

<Layout
  title="Contact"
  description="Get in touch with René Verdugo — available for freelance projects and collaborations."
>
  <div class="max-w-[1200px] mx-auto px-6 xl:px-0 py-16 md:py-20">
    <div class="flex flex-col lg:flex-row gap-16 xl:gap-24 items-start">

      <!-- ── Left column ── -->
      <div class="flex-1">
        <!-- Availability badge -->
        <div
          class="inline-flex items-center gap-2 rounded-full px-4 py-1.5 mb-8"
          style="background-color: var(--bg-3);"
        >
          <span class="w-[7px] h-[7px] rounded-full bg-green-500 shrink-0"></span>
          <span class="text-[12px] font-medium" style="color: var(--fg-2);">
            Available for new projects
          </span>
        </div>

        <!-- H1 -->
        <h1
          class="text-[64px] md:text-[80px] font-bold leading-[1.0] mb-6"
          style="color: var(--fg);"
        >
          Let's talk.
        </h1>

        <!-- Subtitle -->
        <p class="text-[18px] leading-[1.6] mb-8 max-w-[480px]" style="color: var(--fg-2);">
          I'm open to freelance projects, collaborations<br class="hidden md:block" /> and interesting design challenges.
        </p>

        <!-- Email -->
        <a
          href="mailto:dwrenevs@gmail.com"
          class="inline-block text-[20px] font-semibold mb-12 transition-opacity hover:opacity-70"
          style="color: var(--accent);"
        >
          hola@renverdugo.xyz
        </a>

        <!-- Availability -->
        <div class="mb-8">
          <p
            class="text-[11px] font-bold tracking-[2px] uppercase mb-3"
            style="color: var(--accent);"
          >
            AVAILABILITY
          </p>
          <p class="text-[15px] leading-[1.65] max-w-[380px]" style="color: var(--fg-2);">
            Currently open to new projects and freelance work. Response time is usually within
            24–48 hours.
          </p>
        </div>

        <!-- Accent bar -->
        <div
          class="mb-6"
          style="width: 36px; height: 2px; background-color: var(--accent);"
        ></div>

        <!-- Social links -->
        <p
          class="text-[11px] font-bold tracking-[2px] uppercase mb-4"
          style="color: var(--accent);"
        >
          FIND ME ON
        </p>
        <div class="flex flex-col gap-2">
          {
            socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between rounded-lg px-4 h-11 transition-opacity hover:opacity-80"
                style="background-color: var(--bg-3); width: 460px; max-width: 100%;"
              >
                <span class="text-[14px] font-medium" style="color: var(--fg);">
                  {s.name}
                </span>
                <span class="text-[13px]" style="color: var(--accent);">
                  {s.handle}
                </span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- ── Right column: form card ── -->
      <div
        class="w-full lg:w-[580px] xl:w-[620px] shrink-0 rounded-2xl p-8 md:p-10"
        style="background-color: var(--bg-3);"
      >
        <h2 class="text-[20px] font-semibold mb-6" style="color: var(--fg);">Send a message</h2>

        <!-- Success / error banners -->
        <div
          data-fs-success
          class="hidden mb-5 px-4 py-3 rounded-lg text-[14px] font-medium"
          style="background-color: var(--accent-sub); color: var(--accent);"
        >
          Message sent! I'll get back to you soon.
        </div>
        <div
          data-fs-error
          class="hidden mb-5 px-4 py-3 rounded-lg text-[14px]"
          style="background-color: #2c1a1a; color: #f87171;"
        >
        </div>

        <form id="contact-form" class="flex flex-col gap-5">
          <input type="text" name="_gotcha" style="display:none;" tabindex="-1" autocomplete="off" />
          <!-- Name + Email row -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="flex flex-col gap-[7px]">
              <label for="name" class="text-[12px] font-semibold" style="color: var(--fg-2);">
                Name
              </label>
              <input
                id="name"
                name="name"
                type="text"
                required
                placeholder="Your name"
                data-fs-field
                class="field-input h-11 px-4 rounded-lg border text-[14px] outline-none"
                style="background-color: var(--bg-2); border-color: var(--bd); color: var(--fg);"
              />
              <span data-fs-error="name" class="fs-field-error text-[12px] hidden" style="color: #f87171;"></span>
            </div>
            <div class="flex flex-col gap-[7px]">
              <label for="email" class="text-[12px] font-semibold" style="color: var(--fg-2);">
                Email
              </label>
              <input
                id="email"
                name="email"
                type="email"
                required
                placeholder="your@email.com"
                data-fs-field
                class="field-input h-11 px-4 rounded-lg border text-[14px] outline-none"
                style="background-color: var(--bg-2); border-color: var(--bd); color: var(--fg);"
              />
              <span data-fs-error="email" class="fs-field-error text-[12px] hidden" style="color: #f87171;"></span>
            </div>
          </div>

          <!-- Subject -->
          <div class="flex flex-col gap-[7px]">
            <label for="subject" class="text-[12px] font-semibold" style="color: var(--fg-2);">
              Subject
            </label>
            <input
              id="subject"
              name="subject"
              type="text"
              placeholder="What's it about?"
              class="field-input h-11 px-4 rounded-lg border text-[14px] outline-none"
              style="background-color: var(--bg-2); border-color: var(--bd); color: var(--fg);"
            />
          </div>

          <!-- Message -->
          <div class="flex flex-col gap-[7px]">
            <label for="message" class="text-[12px] font-semibold" style="color: var(--fg-2);">
              Message
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              placeholder="Tell me about your project..."
              data-fs-field
              class="field-input px-4 py-3 rounded-lg border text-[14px] outline-none resize-none leading-[1.6]"
              style="background-color: var(--bg-2); border-color: var(--bd); color: var(--fg);"
            ></textarea>
            <span data-fs-error="message" class="fs-field-error text-[12px] hidden" style="color: #f87171;"></span>
          </div>

          <!-- Submit -->
          <div class="flex justify-end">
            <button
              type="submit"
              data-fs-submit-btn
              class="h-11 px-7 rounded-lg text-[14px] font-semibold text-white transition-opacity hover:opacity-85 disabled:opacity-50 disabled:cursor-not-allowed"
              style="background-color: var(--accent);"
            >
              Send message →
            </button>
          </div>
        </form>
      </div>

    </div>
  </div>
</Layout>

<style>
  .field-input:focus {
    border-color: var(--accent);
  }
  [data-fs-error]:empty {
    display: none !important;
  }
</style>

<script>
  import { initForm } from "@formspree/ajax";
  initForm({ formElement: "#contact-form", formId: "xvznbkaq" });
</script>
